# Discord bot token
TOKEN=your_discord_bot_token_here

# Discord OAuth2 application credentials
CLIENT_ID=your_discord_client_id
CLIENT_SECRET=your_discord_client_secret

# OAuth2 endpoints
AUTHORIZE_URL=https://example.com/oauth/authorize
REDIRECT_URI=https://example.com/oauth/callback
TOKEN_URL=https://example.com/oauth/token
USER_API_URL=https://example.com/api/user

# MySQL database
DB_USER=db_username
DB_PASSWORD=db_password
DB_SERVER=localhost
DB_DATABASE=database_name

# Logging level: INFO (default) suppresses verbose debug output.
# Set to DEBUG to enable detailed tracing including OAuth state and membership data.
LOG_LEVEL=INFO
